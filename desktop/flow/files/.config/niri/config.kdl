// Flow desktop with niri spatial tiling
// Keyboard: Japanese (jp). Super = Windows key.
// No Waybar; Noctalia provides panel, launcher and tray.
spawn-at-startup "@HOME@/.local/bin/noctalia-flow"
spawn-at-startup "fcitx5" "-r"
spawn-at-startup "lxpolkit"

input {
    keyboard {
        xkb {
            layout "jp"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

// Set desktop-wide defaults for programs started by niri.
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    TERMINAL "wezterm"
    QT_QPA_PLATFORMTHEME "qt6ct"
    XCURSOR_THEME "breeze_cursors"
    XCURSOR_SIZE "24"
}

layout {
    gaps 14
    center-focused-column "on-overflow"
    always-center-single-column
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    focus-ring {
        width 1
        active-color "#007aff99"
        inactive-color "#00000000"
    }
    border {
        off
    }
    shadow {
        on
        softness 30
        spread 0
        offset x=0 y=6
        color "#00000030"
    }
}

// Keep compatible app-specific behavior from your existing configuration.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
window-rule {
    match app-id="dev.vencord.Vesktop"
    draw-border-with-background false
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Niri screenshot dialog; saved to Pictures/Screenshots.
screenshot-path "@HOME@/Pictures/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

binds {
    // Application launcher and daily apps
    Super+Space hotkey-overlay-title="Application launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Super+E hotkey-overlay-title="Files" { spawn "nautilus"; }
    Super+T hotkey-overlay-title="Terminal (WezTerm)" { spawn "@HOME@/.local/bin/wezterm" "start"; }
    Super+B hotkey-overlay-title="Web browser (Firefox)" { spawn "firefox"; }
    Super+I hotkey-overlay-title="Desktop settings (Noctalia)" { spawn "noctalia" "msg" "settings-open"; }
    Super+Shift+Slash { show-hotkey-overlay; }

    // Conventional window management
    Alt+F4 { close-window; }
    Super+Left { focus-column-left; }
    Super+Right { focus-column-right; }
    Super+Up { focus-window-up; }
    Super+Down { focus-window-down; }
    Super+Shift+Left { move-column-left; }
    Super+Shift+Right { move-column-right; }
    Super+Shift+Up { move-window-up; }
    Super+Shift+Down { move-window-down; }
    Super+F { maximize-column; }
    Super+Shift+F { fullscreen-window; }
    Super+Ctrl+F { fullscreen-window; }
    Super+V { toggle-window-floating; }
    Super+Tab repeat=false { toggle-overview; }
    Super+W { close-window; }
    Super+Shift+W { toggle-column-tabbed-display; }
    Super+R { switch-preset-column-width; }
    Super+BracketLeft { consume-or-expel-window-left; }
    Super+BracketRight { consume-or-expel-window-right; }
    Alt+Tab repeat=false { spawn "noctalia" "msg" "window-switcher" "hold"; }
    Super+Shift+3 { screenshot-screen; }
    Super+Shift+4 { screenshot; }
    Super+A { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Super+L { spawn "noctalia" "msg" "session" "lock"; }
    Super+Comma { spawn "noctalia" "msg" "settings-open"; }
    Super+Minus { set-column-width "-10%"; }
    Super+Equal { set-column-width "+10%"; }

    // Workspaces: Super+number; move a column with Super+Ctrl+number
    Super+1 { focus-workspace 1; }
    Super+2 { focus-workspace 2; }
    Super+3 { focus-workspace 3; }
    Super+4 { focus-workspace 4; }
    Super+5 { focus-workspace 5; }
    Super+Ctrl+1 { move-column-to-workspace 1; }
    Super+Ctrl+2 { move-column-to-workspace 2; }
    Super+Ctrl+3 { move-column-to-workspace 3; }
    Super+Ctrl+4 { move-column-to-workspace 4; }
    Super+Ctrl+5 { move-column-to-workspace 5; }
    Super+Page_Up { focus-workspace-up; }
    Super+Page_Down { focus-workspace-down; }

    // Screenshot: Plasma-like Print / Alt+Print
    Print { screenshot; }
    Alt+Print { screenshot-window; }
    Ctrl+Print { screenshot-screen; }

    // Laptop multimedia keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down" "5"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-volume-mute"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Escape route if an app inhibits shortcuts
    Super+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Ctrl+Alt+Delete { quit; }
}

// Focus colors are intentionally stable across wallpaper changes.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^(dev\.noctalia\.Noctalia|org\.fcitx\.fcitx5-config-qt)$"#
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 760; }
}

// Waydroid is one tiled window; Android apps stay inside it.
window-rule {
    match app-id=r#"^(waydroid\..*|Waydroid)$"#
    open-floating false
    open-fullscreen false
    open-maximized false
    default-column-width {}
    default-window-height { proportion 1.0; }
    geometry-corner-radius 12
}
