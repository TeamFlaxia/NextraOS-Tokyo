@@ -4162,3 +4166,22 @@ void Bar::registerIpc(IpcService& ipc) {
     return setBarLayerIpc(args);
   });
 }
+
+// Compact bar inputs receive events only while this bar owns keyboard focus.
+bool Bar::onKeyboardEvent(const KeyboardEvent& event) {
+  if (m_platform == nullptr) return false;
+  for (auto& instance : m_instances) {
+    if (instance->surface == nullptr || instance->surface->wlSurface() != m_platform->lastKeyboardSurface()) continue;
+    if (instance->inputDispatcher.focusedArea() == nullptr) return false;
+    if (event.pressed && event.sym == XKB_KEY_Escape) {
+      instance->inputDispatcher.setFocus(nullptr);
+      instance->surface->setKeyboardInteractivity(LayerShellKeyboard::None);
+      instance->surface->requestRedraw();
+      return true;
+    }
+    instance->inputDispatcher.keyEvent(event.sym, event.utf32, event.modifiers, event.pressed, event.preedit);
+    instance->surface->requestRedraw();
+    return true;
+  }
+  return false;
+}
