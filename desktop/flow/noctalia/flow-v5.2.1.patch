diff --git a/src/compositors/compositor_platform.cpp b/src/compositors/compositor_platform.cpp
index fe63e3a..f42ed93 100644
--- a/src/compositors/compositor_platform.cpp
+++ b/src/compositors/compositor_platform.cpp
@@ -803,6 +803,20 @@ void CompositorPlatform::probeFocusedOutput(
 }
 
 std::optional<ActiveToplevel> CompositorPlatform::activeToplevel() const {
+  // Niri exposes focus through its IPC stream; ext-foreign-toplevel has no
+  // activated state. Use cached IPC metadata, including after shell startup.
+  if (compositors::detect() == compositors::CompositorKind::Niri && m_workspaceMetadataBackend != nullptr) {
+    const auto focused = m_workspaceMetadataBackend->focusedWindowId();
+    if (focused.has_value()) {
+      for (const auto& window : m_workspaceMetadataBackend->workspaceWindows()) {
+        if (window.windowId == *focused) {
+          return ActiveToplevel{ .title = window.title, .appId = window.appId,
+              .identifier = window.windowId, .handle = nullptr };
+        }
+      }
+    }
+    return std::nullopt;
+  }
   if (compositors::isKde() && m_kwinActiveWindow != nullptr && m_kwinActiveWindow->isAvailable()) {
     return m_kwinActiveWindow->current();
   }
