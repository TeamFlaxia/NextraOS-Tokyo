#!/bin/bash
# NextraOS Post-Install Script
# Called by Calamares after installation completes
set -e

LOG_FILE="/var/log/nextraos-postinstall.log"
SELECTED_APPS="${1:-linux}"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log "NextraOS post-install starting"
log "Selected apps: $SELECTED_APPS"

# Function to check if component is selected
has_component() {
    echo "$SELECTED_APPS" | grep -q "$1"
}

# Resolve Android system type from selection tokens
get_android_system_type() {
    case "$SELECTED_APPS" in
        *android-gapps*) echo "GAPPS" ;;
        *android-vanilla*|*android*) echo "VANILLA" ;;
        *) echo "" ;;
    esac
}

# 1. Flatpak setup (always)
log "Setting up Flatpak..."
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
log "Flatpak setup complete"

# 2. Waydroid setup (Android)
ANDROID_TYPE=$(get_android_system_type)
if [ -n "$ANDROID_TYPE" ]; then
    log "Setting up Waydroid (system type: $ANDROID_TYPE)..."
    mkdir -p /etc/waydroid
    printf '%s\n' "$ANDROID_TYPE" > /etc/waydroid/system_type
    if command -v waydroid &>/dev/null; then
        # Ensure binder nodes are available
        if ! ls /dev/binder /dev/vndbinder /dev/hwbinder >/dev/null 2>&1; then
            log "Setting up binder nodes..."
            modprobe binder_linux devices="binder,hwbinder,vndbinder" 2>/dev/null || true
            mkdir -p /dev/binderfs
            mount -t binder binder /dev/binderfs 2>/dev/null || true
            ln -sf /dev/binderfs/* /dev/ 2>/dev/null || true
        fi
        if [ -f /etc/waydroid-extra/images/system.img ] || [ -f /var/lib/waydroid/images/system.img ]; then
            waydroid init -f -s "$ANDROID_TYPE" 2>/dev/null || log "Waydroid init failed (may need manual setup)"
        else
            waydroid init -s "$ANDROID_TYPE" 2>/dev/null || log "Waydroid init failed (may need manual setup)"
        fi
        log "Waydroid setup complete"
    else
        log "Waydroid not installed, skipping"
    fi
fi

# 3. Windows VM setup
if has_component "windows"; then
    log "Setting up Windows VM support..."
    systemctl enable libvirtd 2>/dev/null || true
    usermod -aG libvirt "$SUDO_USER" 2>/dev/null || true
    log "Windows VM setup complete"
fi

# 4. macOS VM setup (Experimental)
if has_component "macos"; then
    log "Setting up macOS VM support (experimental)..."
    systemctl enable libvirtd 2>/dev/null || true
    usermod -aG libvirt "$SUDO_USER" 2>/dev/null || true
    log "macOS VM setup complete"
fi

# 5. Enable NextraOS services
log "Enabling NextraOS services..."
systemctl enable nextraos-vm.target 2>/dev/null || true

# 6. Remove installer from installed system
log "Removing installer..."
rm -f /etc/xdg/autostart/calamares.desktop
rm -f /usr/share/applications/calamares.desktop
rm -f /usr/share/applications/nextraos-installer.desktop
rm -f /etc/sudoers.d/calamares
rm -f /usr/local/bin/nextraos-postinstall
rm -rf /usr/lib/calamares/modules/nextraos-postinstall
rm -rf /usr/lib/calamares/modules/waydroid-image-download
rm -rf /etc/calamares
update-desktop-database /usr/share/applications 2>/dev/null || true
log "Installer removed"

log "NextraOS post-install complete"
exit 0
