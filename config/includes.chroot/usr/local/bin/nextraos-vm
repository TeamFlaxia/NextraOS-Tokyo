#!/bin/sh
set -e

# --- Configuration ---
CONF_FILE="${HOME}/.config/nextraos/vm.conf"
load_config() {
    VM_AUTO_SUSPEND="${VM_AUTO_SUSPEND:-true}"
    VM_SUSPEND_GRACE_PERIOD="${VM_SUSPEND_GRACE_PERIOD:-30}"
    VM_SUSPEND_ON_SYSTEM_SUSPEND="${VM_SUSPEND_ON_SYSTEM_SUSPEND:-true}"
    VM_READY_TIMEOUT="${VM_READY_TIMEOUT:-120}"
    VM_HUGEPAGES="${VM_HUGEPAGES:-false}"
    VM_SAVE_MAX_AGE_DAYS="${VM_SAVE_MAX_AGE_DAYS:-7}"
    VM_SNAPSHOT_MAX_COUNT="${VM_SNAPSHOT_MAX_COUNT:-10}"
    if [ -f "$CONF_FILE" ]; then
        # shellcheck source=/dev/null
        . "$CONF_FILE"
    fi
}

usage() {
    cat << 'EOF'
Usage: nextraos-vm <action> [options]

Actions:
  start <windows|macos>         Start VM
  stop <windows|macos>          Stop VM
  status [windows|macos]        Show VM status
  list                          List all VMs
  create <windows|macos>        Create VM disk
  download-iso <windows|macos>  Download OS installer
  connect <windows|macos>       Ensure VM running and open SPICE viewer
  execute [options] <windows|macos> <app>  Execute app in VM
  suspend <windows|macos>       Suspend VM (save state, free RAM)
  resume <windows|macos>        Resume VM from saved state
  snapshot <windows|macos> [name]  Create snapshot
  restore-snapshot <windows|macos> [name]  Restore snapshot
  list-snapshots <windows|macos>   List snapshots
  delete-snapshot <windows|macos> <name>  Delete snapshot
  enable <windows|macos>        Enable autostart (systemd user service)
  disable <windows|macos>       Disable autostart
  setmem <windows|macos> <MB>   Adjust VM memory at runtime (balloon)

Options (for execute):
  --headless            Disable SPICE display (execute-only mode)
  --no-auto-suspend     Disable auto-suspend after app exits

Examples:
  nextraos-vm create windows
  nextraos-vm start windows
  nextraos-vm connect windows
  nextraos-vm execute windows "C:\Program Files\App\app.exe"
  nextraos-vm execute --headless windows "C:\app.exe"
  nextraos-vm suspend windows
  nextraos-vm resume windows
  nextraos-vm connect macos
  nextraos-vm snapshot macos "before-update"
EOF
    exit 1
}

# --- Resource auto-adjustment ---
get_vm_resources() {
    HOST_RAM_KB=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)

    if [ "$HOST_RAM_KB" -ge 32768000 ]; then
        echo "8192 4"
    elif [ "$HOST_RAM_KB" -ge 16384000 ]; then
        echo "4096 2"
    else
        echo "2048 2"
    fi
}

# --- Agent/SSH ready detection ---
wait_for_agent_ready() {
    VM_NAME="$1"
    TIMEOUT="${VM_READY_TIMEOUT:-120}"
    ELAPSED=0
    echo -n "==> Waiting for guest agent"
    while [ "$ELAPSED" -lt "$TIMEOUT" ]; do
        if virsh qemu-agent-command "$VM_NAME" \
            '{"execute":"guest-sync","arguments":{"id":1}}' \
            >/dev/null 2>&1; then
            echo " ready (${ELAPSED}s)"
            return 0
        fi
        echo -n "."
        sleep 1
        ELAPSED=$((ELAPSED + 1))
    done
    echo " timeout (${TIMEOUT}s)"
    return 1
}

wait_for_ssh_ready() {
    TIMEOUT="${VM_READY_TIMEOUT:-120}"
    ELAPSED=0
    echo -n "==> Waiting for SSH"
    while [ "$ELAPSED" -lt "$TIMEOUT" ]; do
        if ssh -p 2222 -o ConnectTimeout=1 -o BatchMode=yes \
            user@localhost true 2>/dev/null; then
            echo " ready (${ELAPSED}s)"
            return 0
        fi
        echo -n "."
        sleep 1
        ELAPSED=$((ELAPSED + 1))
    done
    echo " timeout (${TIMEOUT}s)"
    return 1
}

# --- Suspend helpers ---
VM_BASE_DIR="$HOME/.local/share/nextraos/vms"

# Auto-resume from saved state if available
cmd_vm_auto_resume() {
    local VM_NAME="$1"
    local SAVE_DIR="$VM_BASE_DIR/$VM_NAME/save"
    local SAVE_FILE

    SAVE_FILE=$(ls -t "$SAVE_DIR"/*.sav 2>/dev/null | head -1)
    if [ -z "$SAVE_FILE" ]; then
        return 1
    fi

    echo "==> Resuming $VM_NAME from saved state: $SAVE_FILE"
    virsh restore "$SAVE_FILE" >/dev/null 2>&1 || {
        echo "==> Resume failed"
        return 1
    }
    echo "==> $VM_NAME resumed from saved state"
    return 0
}

# Cleanup old save files
cleanup_old_saves() {
    local VM_NAME="$1"
    local MAX_AGE="${VM_SAVE_MAX_AGE_DAYS:-7}"
    local SAVE_DIR="$VM_BASE_DIR/$VM_NAME/save"

    if [ ! -d "$SAVE_DIR" ]; then
        return 0
    fi

    local DELETED
    DELETED=$(find "$SAVE_DIR" -name "*.sav" -mtime "+$MAX_AGE" -delete -print 2>/dev/null | wc -l)
    if [ "$DELETED" -gt 0 ]; then
        echo "==> Cleaned up $DELETED old save file(s) for $VM_NAME"
    fi
}

# Rotate snapshots if over limit
rotate_snapshots() {
    local VM_NAME="$1"
    local MAX_COUNT="${VM_SNAPSHOT_MAX_COUNT:-10}"

    local SNAP_COUNT
    SNAP_COUNT=$(virsh snapshot-list "$VM_NAME" --name 2>/dev/null | wc -l)
    if [ "$SNAP_COUNT" -ge "$MAX_COUNT" ]; then
        local OLDEST
        OLDEST=$(virsh snapshot-list "$VM_NAME" --name 2>/dev/null | head -1)
        if [ -n "$OLDEST" ]; then
            echo "==> Rotating snapshots: removing '$OLDEST' (limit: $MAX_COUNT)"
            virsh snapshot-delete "$VM_NAME" "$OLDEST" >/dev/null 2>&1 || true
        fi
    fi
}

cmd_vm_suspend() {
    local VM_NAME="$1"
    local SAVE_DIR="$VM_BASE_DIR/$VM_NAME/save"
    mkdir -p "$SAVE_DIR"

    if ! virsh dominfo "$VM_NAME" >/dev/null 2>&1; then
        echo "==> $VM_NAME is not running"
        return 1
    fi

    cleanup_old_saves "$VM_NAME"
    local SAVE_FILE="$SAVE_DIR/suspend-$(date +%Y%m%d-%H%M%S).sav"
    echo "==> Suspending $VM_NAME..."
    virsh save "$VM_NAME" "$SAVE_FILE" >/dev/null 2>&1
    echo "==> $VM_NAME suspended. Memory freed. Save: $SAVE_FILE"
}

cmd_vm_resume() {
    local VM_NAME="$1"
    local SAVE_DIR="$VM_BASE_DIR/$VM_NAME/save"
    local SAVE_FILE

    SAVE_FILE=$(ls -t "$SAVE_DIR"/suspend-*.sav 2>/dev/null | head -1)
    if [ -z "$SAVE_FILE" ]; then
        echo "==> No save file found for $VM_NAME"
        return 1
    fi

    echo "==> Resuming $VM_NAME from $SAVE_FILE"
    virsh restore "$SAVE_FILE" >/dev/null 2>&1
    echo "==> $VM_NAME resumed"
}

# --- Snapshot helpers ---
cmd_vm_snapshot() {
    local VM_NAME="$1"
    local SNAP_NAME="${2:-snap-$(date +%Y%m%d-%H%M%S)}"

    if ! virsh dominfo "$VM_NAME" >/dev/null 2>&1; then
        echo "==> $VM_NAME is not running"
        return 1
    fi

    rotate_snapshots "$VM_NAME"
    echo "==> Creating snapshot '$SNAP_NAME' for $VM_NAME"
    virsh snapshot-create-as "$VM_NAME" "$SNAP_NAME" "" \
        --atomic >/dev/null 2>&1
    echo "==> Snapshot '$SNAP_NAME' created"
}

cmd_vm_restore_snapshot() {
    local VM_NAME="$1"
    local SNAP_NAME="$2"

    if [ -z "$SNAP_NAME" ]; then
        SNAP_NAME=$(virsh snapshot-list "$VM_NAME" --name 2>/dev/null | tail -1)
        if [ -z "$SNAP_NAME" ]; then
            echo "==> No snapshots found for $VM_NAME"
            return 1
        fi
        echo "==> Using latest snapshot: $SNAP_NAME"
    fi

    echo "==> Restoring snapshot '$SNAP_NAME' for $VM_NAME"
    virsh snapshot-revert "$VM_NAME" "$SNAP_NAME" >/dev/null 2>&1
    echo "==> Snapshot '$SNAP_NAME' restored"
}

cmd_vm_list_snapshots() {
    local VM_NAME="$1"
    echo "==> Snapshots for $VM_NAME:"
    virsh snapshot-list "$VM_NAME" 2>/dev/null || echo "  (none)"
}

cmd_vm_delete_snapshot() {
    local VM_NAME="$1"
    local SNAP_NAME="$2"

    if [ -z "$SNAP_NAME" ]; then
        echo "Usage: nextraos-vm delete-snapshot <vm> <name>" >&2
        exit 1
    fi

    echo "==> Deleting snapshot '$SNAP_NAME' from $VM_NAME"
    virsh snapshot-delete "$VM_NAME" "$SNAP_NAME" >/dev/null 2>&1
    echo "==> Snapshot '$SNAP_NAME' deleted"
}

# --- Memory management ---
cmd_vm_setmem() {
    local VM_NAME="$1"
    local NEW_RAM="$2"

    if [ -z "$NEW_RAM" ]; then
        echo "Usage: nextraos-vm setmem <vm> <MB>" >&2
        exit 1
    fi

    if ! virsh dominfo "$VM_NAME" >/dev/null 2>&1; then
        echo "==> $VM_NAME is not running"
        return 1
    fi

    echo "==> Setting $VM_NAME memory to ${NEW_RAM}MB"
    virsh setmem "$VM_NAME" "$((NEW_RAM * 1024))" --config >/dev/null 2>&1
    echo "==> Memory updated (takes effect on next start, or use --live for immediate)"
}

setup_hugepages() {
    if [ "${VM_HUGEPAGES:-false}" != "true" ]; then
        return 0
    fi

    local VM_RAM_MB="$1"
    local HP_SIZE_KB=2048
    local NEEDED=$((VM_RAM_MB * 1024 / HP_SIZE_KB))
    local CURRENT=$(cat /proc/sys/vm/nr_hugepages 2>/dev/null || echo 0)

    if [ "$CURRENT" -ge "$NEEDED" ]; then
        echo "==> Hugepages already allocated ($CURRENT pages)"
        return 0
    fi

    echo "==> Allocating hugepages for VM (${NEEDED} pages, ${HP_SIZE_KB}kB each)"
    echo "$NEEDED" > /proc/sys/vm/nr_hugepages 2>/dev/null || {
        echo "==> WARNING: Could not allocate hugepages (may need root or sysctl)"
        return 1
    }
    echo "==> Hugepages allocated"
}

get_hugepages_xml() {
    if [ "${VM_HUGEPAGES:-false}" != "true" ]; then
        return 0
    fi
    cat << 'HUGEXML'
    <memoryBacking>
      <hugepages>
        <page size='2048' unit='KiB'/>
      </hugepages>
    </memoryBacking>
HUGEXML
}

# --- SPICE connect helper ---
cmd_vm_connect() {
    local TARGET="$1"

    case "$TARGET" in
        windows)
            if ! virsh dominfo "$VM_WIN_NAME" >/dev/null 2>&1; then
                if [ ! -f "$VM_WIN_DISK" ]; then
                    echo "==> Windows VM disk not found. Run: nextraos-vm create windows"
                    echo "    Then: nextraos-vm download-iso windows"
                    exit 1
                fi
                echo "==> Starting Windows VM..."
                cmd_windows_start
            fi
            SPICE_PORT="$VM_WIN_SPICE"
            ;;
        macos)
            if ! virsh dominfo "$VM_MAC_NAME" >/dev/null 2>&1; then
                if [ ! -f "$VM_MAC_DISK" ]; then
                    echo "==> macOS VM disk not found. Run: nextraos-vm create macos"
                    echo "    Then: nextraos-vm download-iso macos"
                    exit 1
                fi
                echo "==> Starting macOS VM..."
                cmd_macos_start
            fi
            SPICE_PORT="$VM_MAC_SPICE"
            ;;
        *)
            echo "Specify: windows or macos"
            usage
            ;;
    esac

    VIEWER=""
    for candidate in remote-viewer virt-viewer; do
        if command -v "$candidate" >/dev/null 2>&1; then
            VIEWER="$candidate"
            break
        fi
    done
    if [ -z "$VIEWER" ]; then
        echo "==> No SPICE viewer found. Install with: sudo apt install virt-viewer"
        echo "==> SPICE endpoint: spice://localhost:$SPICE_PORT"
        exit 1
    fi

    echo "==> Connecting via SPICE: spice://localhost:$SPICE_PORT"
    "$VIEWER" "spice://localhost:$SPICE_PORT" >/dev/null 2>&1 &
}

# --- Windows VM ---
VM_WIN_NAME="windows"
VM_WIN_DIR="$HOME/.local/share/nextraos/vms/windows"
VM_WIN_DISK="$VM_WIN_DIR/disk.qcow2"
VM_WIN_SPICE="5930"

cmd_windows_create() {
    mkdir -p "$VM_WIN_DIR"
    if [ -f "$VM_WIN_DISK" ]; then
        echo "==> Windows VM disk already exists: $VM_WIN_DISK"
        return 0
    fi
    echo "==> Creating Windows VM disk (32GB, expandable)"
    qemu-img create -f qcow2 "$VM_WIN_DISK" 32G
    echo "==> Disk created: $VM_WIN_DISK"
}

cmd_windows_download_iso() {
    mkdir -p "$VM_WIN_DIR"
    ISO_FILE="$VM_WIN_DIR/windows.iso"
    if [ -f "$ISO_FILE" ]; then
        echo "==> Windows ISO already exists: $ISO_FILE"
        return 0
    fi
    echo "==> Downloading Windows 11 ISO from Microsoft CDN..."
    echo "    Review Microsoft Software License Terms (EULA) before use."
    echo "    NextraOS is not affiliated with Microsoft."
    curl -L -o "$ISO_FILE" \
        "https://software-download.microsoft.com/download/sg/17763.5576.231006-0600.23H2_RELEASE_SVC_PROD2_CLIENT64EN-US_JPEG.iso" || {
        echo "==> Download failed. Place a Windows ISO manually in: $VM_WIN_DIR/"
        exit 1
    }
    echo "==> ISO downloaded: $ISO_FILE"
}

cmd_windows_start() {
    mkdir -p "$VM_WIN_DIR"
    if [ ! -f "$VM_WIN_DISK" ]; then
        echo "==> VM disk not found. Run: nextraos-vm create windows"
        exit 1
    fi
    if virsh dominfo "$VM_WIN_NAME" >/dev/null 2>&1; then
        echo "==> Windows VM is already running"
        virsh dominfo "$VM_WIN_NAME"
        return 0
    fi
    ISO_FILE=$(find "$VM_WIN_DIR" -name "*.iso" -type f 2>/dev/null | head -1)
    if [ -z "$ISO_FILE" ]; then
        echo "==> No Windows ISO found. Run: nextraos-vm download-iso windows"
        exit 1
    fi
    read -r VM_RAM VM_CPUS <<< "$(get_vm_resources)"
    echo "==> Starting Windows VM (RAM: ${VM_RAM}MB, CPUs: $VM_CPUS)"
    setup_hugepages "$VM_RAM"
    virt-install \
        --name "$VM_WIN_NAME" \
        --ram "$VM_RAM" \
        --vcpus "$VM_CPUS" \
        --disk path="$VM_WIN_DISK",format=qcow2,bus=virtio,cache=none,discard=unmap \
        --os-variant win11 \
        --network model=virtio \
        --graphics spice,listen=0.0.0.0,port="$VM_WIN_SPICE" \
        --video qxl \
        --cdrom "$ISO_FILE" \
        --boot uefi \
        --cpu host-passthrough \
        --features hyperv.relaxed=on,hyperv.vapic=on,hyperv.spinlocks=on \
        --memballoon model=virtio \
        $(get_hugepages_xml | sed 's/^/--xml /' | tr '\n' ' ') \
        --noautoconsole 2>/dev/null
    echo "==> Windows VM started. SPICE: spice://localhost:$VM_WIN_SPICE"
}

cmd_windows_stop() {
    if ! virsh dominfo "$VM_WIN_NAME" >/dev/null 2>&1; then
        echo "==> Windows VM is not running"
        return 0
    fi
    echo "==> Stopping Windows VM"
    virsh shutdown "$VM_WIN_NAME" 2>/dev/null || true
    TIMEOUT=30; ELAPSED=0
    while virsh dominfo "$VM_WIN_NAME" >/dev/null 2>&1; do
        sleep 1; ELAPSED=$((ELAPSED + 1))
        [ "$ELAPSED" -ge "$TIMEOUT" ] && virsh destroy "$VM_WIN_NAME" 2>/dev/null || true
    done
    echo "==> Windows VM stopped"
}

cmd_windows_status() {
    if virsh dominfo "$VM_WIN_NAME" >/dev/null 2>&1; then
        echo "==> Windows VM is running"
        virsh dominfo "$VM_WIN_NAME"
    else
        echo "==> Windows VM is not running"
    fi
}

cmd_windows_execute() {
    local APP="$1"
    local HEADLESS="$2"
    local AUTO_SUSPEND="$3"

    if [ -z "$APP" ]; then
        echo "Usage: nextraos-vm execute [options] windows <app.exe>" >&2
        exit 1
    fi

    # Auto-resume or start if not running
    if ! virsh dominfo "$VM_WIN_NAME" >/dev/null 2>&1; then
        cleanup_old_saves "$VM_WIN_NAME"
        if ! cmd_vm_auto_resume "$VM_WIN_NAME"; then
            echo "==> Windows VM is not running. Starting fresh..."
            cmd_windows_start
        fi
        wait_for_agent_ready "$VM_WIN_NAME"
    fi

    # Execute via guest agent
    echo "==> Executing in Windows VM: $APP"
    RESULT=$(virsh qemu-agent-command "$VM_WIN_NAME" \
        "{\"execute\":\"guest-exec\",\"arguments\":{\"path\":\"cmd.exe\",\"arg\":[\"/c\",\"$APP\"],\"capture-output\":true}}" \
        2>/dev/null) || {
        echo "==> Could not execute via agent. Connect via SPICE: spice://localhost:$VM_WIN_SPICE"
        return 1
    }

    EXEC_PID=$(echo "$RESULT" | jq -r '.return.pid 2>/dev/null')
    if [ -z "$EXEC_PID" ] || [ "$EXEC_PID" = "null" ]; then
        echo "==> Could not get process ID from agent"
        return 1
    fi

    echo "==> App started (PID: $EXEC_PID)"

    # Auto-suspend tracking
    if [ "$AUTO_SUSPEND" = "true" ] && [ "${VM_AUTO_SUSPEND:-true}" = "true" ]; then
        (
            while true; do
                STATUS=$(virsh qemu-agent-command "$VM_WIN_NAME" \
                    "{\"execute\":\"guest-exec-status\",\"arguments\":{\"pid\":$EXEC_PID}}" \
                    2>/dev/null) || break
                EXITED=$(echo "$STATUS" | jq -r '.return.exited 2>/dev/null')
                if [ "$EXITED" = "true" ]; then
                    GRACE="${VM_SUSPEND_GRACE_PERIOD:-30}"
                    echo "==> App exited. Waiting ${GRACE}s before suspend..."
                    sleep "$GRACE"
                    cleanup_old_saves "$VM_WIN_NAME"
                    virsh save "$VM_WIN_NAME" \
                        "$VM_BASE_DIR/windows/save/auto-suspend-$(date +%Y%m%d-%H%M%S).sav" \
                        >/dev/null 2>&1 && \
                        echo "==> Windows VM auto-suspended. Memory freed." || \
                        echo "==> Auto-suspend failed."
                    break
                fi
                sleep 2
            done
        ) &
        echo "==> Auto-suspend monitor running in background."
    fi
}

# --- macOS VM ---
VM_MAC_NAME="macos"
VM_MAC_DIR="$HOME/.local/share/nextraos/vms/macos"
VM_MAC_DISK="$VM_MAC_DIR/macos.qcow2"
VM_MAC_SPICE="5931"
VM_MAC_OC="$VM_MAC_DIR/OpenCore.qcow2"

cmd_macos_create() {
    mkdir -p "$VM_MAC_DIR"
    if [ -f "$VM_MAC_DISK" ]; then
        echo "==> macOS VM disk already exists: $VM_MAC_DISK"
        return 0
    fi
    echo "==> Creating macOS VM disk (32GB, expandable)"
    qemu-img create -f qcow2 "$VM_MAC_DISK" 32G

    # Create OpenCore disk if not present
    if [ ! -f "$VM_MAC_OC" ]; then
        echo "==> Creating OpenCore boot disk"
        qemu-img create -f qcow2 "$VM_MAC_OC" 200M
    fi
    echo "==> macOS disks created"
}

cmd_macos_download_iso() {
    mkdir -p "$VM_MAC_DIR"
    if [ -f "$VM_MAC_DIR/BaseSystem.img" ]; then
        echo "==> macOS Recovery image already exists"
        return 0
    fi
    echo "==> Downloading macOS Recovery image..."
    echo "    This uses Apple's public CDN for recovery images."
    echo "    Review the Apple Software License Agreement (EULA) before use."
    echo "    Virtualization on non-Apple hardware may be restricted by Apple's EULA."
    echo "    NextraOS is not affiliated with Apple."

    if command -v python3 >/dev/null 2>&1; then
        cd "$VM_MAC_DIR"
        python3 -c "
import urllib.request, plistlib, sys

url = 'https://osrecovery.apple.com/Info.plist?version=14&build=23A344&bank=progress&assets=2'
try:
    resp = urllib.request.urlopen(url)
    data = plistlib.loads(resp.read())
    print('==> Recovery info loaded')
except Exception as e:
    print(f'==> Direct download failed: {e}')
    print('==> Please download macOS Recovery manually or use OSX-KVM project')
    sys.exit(1)
" 2>/dev/null || true
    fi

    echo "==> For full macOS installation:"
    echo "    1. Clone OSX-KVM: git clone https://github.com/kholia/OSX-KVM.git"
    echo "    2. Run: ./fetch-macOS-v2.py"
    echo "    3. Convert: dmg2img -i BaseSystem.dmg BaseSystem.img"
    echo "    4. Place BaseSystem.img in: $VM_MAC_DIR/"
}

cmd_macos_start() {
    mkdir -p "$VM_MAC_DIR"

    # Check for OpenCore
    if [ ! -f "$VM_MAC_OC" ]; then
        echo "==> OpenCore disk not found. Run: nextraos-vm create macos"
        exit 1
    fi

    # Check for macOS disk
    if [ ! -f "$VM_MAC_DISK" ]; then
        echo "==> macOS disk not found. Run: nextraos-vm create macos"
        exit 1
    fi

    if virsh dominfo "$VM_MAC_NAME" >/dev/null 2>&1; then
        echo "==> macOS VM is already running"
        virsh dominfo "$VM_MAC_NAME"
        return 0
    fi

    # Check AVX2 for macOS 13+
    if ! grep -q 'avx2' /proc/cpuinfo; then
        echo "==> WARNING: CPU does not support AVX2"
        echo "    macOS Ventura (13) and later require AVX2"
        echo "    Use macOS Monterey (12) or earlier"
    fi

    read -r VM_RAM VM_CPUS <<< "$(get_vm_resources)"
    # macOS needs more RAM
    [ "$VM_RAM" -lt 4096 ] && VM_RAM=4096

    APPLE_SMC="ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"

    echo "==> Starting macOS VM (RAM: ${VM_RAM}MB, CPUs: $VM_CPUS)"
    setup_hugepages "$VM_RAM"

    virt-install \
        --name "$VM_MAC_NAME" \
        --ram "$VM_RAM" \
        --vcpus "$VM_CPUS" \
        --disk path="$VM_MAC_DISK",format=qcow2,bus=virtio,cache=none,discard=unmap \
        --disk path="$VM_MAC_OC",format=qcow2,bus=virtio,device=cdrom \
        --os-variant macVentura \
        --network model=virtio \
        --graphics spice,listen=0.0.0.0,port="$VM_MAC_SPICE" \
        --video qxl \
        --boot uefi \
        --cpu host-passthrough \
        --memballoon model=virtio \
        --qemu-commandline="-device isa-applesmc,osk=$APPLE_SMC" \
        --qemu-commandline="-smbios type=2" \
        $(get_hugepages_xml | sed 's/^/--xml /' | tr '\n' ' ') \
        --noautoconsole 2>/dev/null

    echo "==> macOS VM started. SPICE: spice://localhost:$VM_MAC_SPICE"
}

cmd_macos_stop() {
    if ! virsh dominfo "$VM_MAC_NAME" >/dev/null 2>&1; then
        echo "==> macOS VM is not running"
        return 0
    fi
    echo "==> Stopping macOS VM"
    virsh shutdown "$VM_MAC_NAME" 2>/dev/null || true
    TIMEOUT=30; ELAPSED=0
    while virsh dominfo "$VM_MAC_NAME" >/dev/null 2>&1; do
        sleep 1; ELAPSED=$((ELAPSED + 1))
        [ "$ELAPSED" -ge "$TIMEOUT" ] && virsh destroy "$VM_MAC_NAME" 2>/dev/null || true
    done
    echo "==> macOS VM stopped"
}

cmd_macos_status() {
    if virsh dominfo "$VM_MAC_NAME" >/dev/null 2>&1; then
        echo "==> macOS VM is running"
        virsh dominfo "$VM_MAC_NAME"
    else
        echo "==> macOS VM is not running"
    fi
}

cmd_macos_execute() {
    local APP="$1"
    local HEADLESS="$2"
    local AUTO_SUSPEND="$3"

    if [ -z "$APP" ]; then
        echo "Usage: nextraos-vm execute [options] macos <app>" >&2
        exit 1
    fi

    # Auto-resume or start if not running
    if ! virsh dominfo "$VM_MAC_NAME" >/dev/null 2>&1; then
        cleanup_old_saves "$VM_MAC_NAME"
        if ! cmd_vm_auto_resume "$VM_MAC_NAME"; then
            echo "==> macOS VM is not running. Starting fresh..."
            cmd_macos_start
        fi
        wait_for_ssh_ready
    fi

    echo "==> Executing in macOS VM: $APP"

    if [ "$AUTO_SUSPEND" = "true" ] && [ "${VM_AUTO_SUSPEND:-true}" = "true" ]; then
        # Block on SSH command, then auto-suspend
        ssh -p 2222 -o StrictHostKeyChecking=no user@localhost "$APP" 2>/dev/null
        EXIT_CODE=$?

        GRACE="${VM_SUSPEND_GRACE_PERIOD:-30}"
        echo "==> App exited (code: $EXIT_CODE). Waiting ${GRACE}s before suspend..."
        sleep "$GRACE"
        cleanup_old_saves "$VM_MAC_NAME"
        virsh save "$VM_MAC_NAME" \
            "$VM_BASE_DIR/macos/save/auto-suspend-$(date +%Y%m%d-%H%M%S).sav" \
            >/dev/null 2>&1 && \
            echo "==> macOS VM auto-suspended. Memory freed." || \
            echo "==> Auto-suspend failed."
    else
        ssh -p 2222 -o StrictHostKeyChecking=no user@localhost "$APP" 2>/dev/null || {
            echo "==> Could not execute via SSH. Connect via SPICE: spice://localhost:$VM_MAC_SPICE"
        }
    fi
}

# --- Parse execute options ---
parse_execute_opts() {
    HEADLESS="false"
    AUTO_SUSPEND="true"

    while [ $# -gt 0 ]; do
        case "$1" in
            --headless)      HEADLESS="true"; shift ;;
            --no-auto-suspend) AUTO_SUSPEND="false"; shift ;;
            *)               break ;;
        esac
    done
}

# --- Autostart (systemd user service) ---
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"

cmd_vm_enable() {
    local VM_NAME="$1"
    local SERVICE_FILE="$SYSTEMD_USER_DIR/nextraos-${VM_NAME}.service"

    mkdir -p "$SYSTEMD_USER_DIR"

    if [ -f "$SERVICE_FILE" ]; then
        echo "==> $VM_NAME autostart already enabled"
        return 0
    fi

    cat > "$SERVICE_FILE" << SERVICEEOF
[Unit]
Description=NextraOS ${VM_NAME} VM
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/virsh start ${VM_NAME}
ExecStop=/usr/local/bin/nextraos-vm suspend ${VM_NAME}
Restart=on-failure

[Install]
WantedBy=default.target
SERVICEEOF

    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable "nextraos-${VM_NAME}.service" 2>/dev/null || true
    echo "==> $VM_NAME autostart enabled"
}

cmd_vm_disable() {
    local VM_NAME="$1"
    local SERVICE_FILE="$SYSTEMD_USER_DIR/nextraos-${VM_NAME}.service"

    if [ ! -f "$SERVICE_FILE" ]; then
        echo "==> $VM_NAME autostart already disabled"
        return 0
    fi

    systemctl --user disable "nextraos-${VM_NAME}.service" 2>/dev/null || true
    rm -f "$SERVICE_FILE"
    systemctl --user daemon-reload 2>/dev/null || true
    echo "==> $VM_NAME autostart disabled"
}

# --- Main dispatch ---
load_config

ACTION="${1:-}"
TARGET="${2:-}"

case "$ACTION" in
    start)
        case "$TARGET" in
            windows) cmd_windows_start ;;
            macos)   cmd_macos_start ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    stop)
        case "$TARGET" in
            windows) cmd_windows_stop ;;
            macos)   cmd_macos_stop ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    status)
        case "$TARGET" in
            windows) cmd_windows_status ;;
            macos)   cmd_macos_status ;;
            "")      cmd_windows_status; cmd_macos_status ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    list)
        echo "==> VMs:"
        virsh list --all 2>/dev/null || true
        ;;
    create)
        case "$TARGET" in
            windows) cmd_windows_create ;;
            macos)   cmd_macos_create ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    download-iso)
        case "$TARGET" in
            windows) cmd_windows_download_iso ;;
            macos)   cmd_macos_download_iso ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    connect)
        cmd_vm_connect "$TARGET"
        ;;
    execute)
        shift
        parse_execute_opts "$@"
        VM_TARGET="${1:-}"
        APP="${2:-}"
        case "$VM_TARGET" in
            windows) cmd_windows_execute "$APP" "$HEADLESS" "$AUTO_SUSPEND" ;;
            macos)   cmd_macos_execute "$APP" "$HEADLESS" "$AUTO_SUSPEND" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    suspend)
        case "$TARGET" in
            windows) cmd_vm_suspend "$VM_WIN_NAME" ;;
            macos)   cmd_vm_suspend "$VM_MAC_NAME" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    resume)
        case "$TARGET" in
            windows) cmd_vm_resume "$VM_WIN_NAME" ;;
            macos)   cmd_vm_resume "$VM_MAC_NAME" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    snapshot)
        VM_TARGET="${2:-}"
        SNAP_NAME="${3:-}"
        case "$VM_TARGET" in
            windows) cmd_vm_snapshot "$VM_WIN_NAME" "$SNAP_NAME" ;;
            macos)   cmd_vm_snapshot "$VM_MAC_NAME" "$SNAP_NAME" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    restore-snapshot)
        VM_TARGET="${2:-}"
        SNAP_NAME="${3:-}"
        case "$VM_TARGET" in
            windows) cmd_vm_restore_snapshot "$VM_WIN_NAME" "$SNAP_NAME" ;;
            macos)   cmd_vm_restore_snapshot "$VM_MAC_NAME" "$SNAP_NAME" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    list-snapshots)
        case "$TARGET" in
            windows) cmd_vm_list_snapshots "$VM_WIN_NAME" ;;
            macos)   cmd_vm_list_snapshots "$VM_MAC_NAME" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    delete-snapshot)
        VM_TARGET="${2:-}"
        SNAP_NAME="${3:-}"
        case "$VM_TARGET" in
            windows) cmd_vm_delete_snapshot "$VM_WIN_NAME" "$SNAP_NAME" ;;
            macos)   cmd_vm_delete_snapshot "$VM_MAC_NAME" "$SNAP_NAME" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    enable)
        case "$TARGET" in
            windows) cmd_vm_enable "$VM_WIN_NAME" ;;
            macos)   cmd_vm_enable "$VM_MAC_NAME" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    disable)
        case "$TARGET" in
            windows) cmd_vm_disable "$VM_WIN_NAME" ;;
            macos)   cmd_vm_disable "$VM_MAC_NAME" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    setmem)
        VM_TARGET="${2:-}"
        NEW_RAM="${3:-}"
        case "$VM_TARGET" in
            windows) cmd_vm_setmem "$VM_WIN_NAME" "$NEW_RAM" ;;
            macos)   cmd_vm_setmem "$VM_MAC_NAME" "$NEW_RAM" ;;
            *)       echo "Specify: windows or macos"; usage ;;
        esac ;;
    *) usage ;;
esac
