#!/bin/sh
set -e

EXECUTABLE="$1"
TIMEOUT="${2:-30}"

if [ -z "$EXECUTABLE" ]; then
    echo "Usage: nextraos-wine-launch <file.exe> [timeout_seconds]" >&2
    exit 1
fi

APP_ID=$(echo "$EXECUTABLE" | md5sum | cut -d' ' -f1)
WINEPREFIX="$HOME/.local/share/nextraos/wine/$APP_ID"
export WINEPREFIX
export WINEDEBUG=-all

# Create prefix if first run
if [ ! -d "$WINEPREFIX" ]; then
    echo "==> Creating Wine prefix: $WINEPREFIX"
    mkdir -p "$WINEPREFIX"
    WINEARCH=win64 wineboot --init 2>/dev/null || true
fi

echo "==> Launching via Wine: $EXECUTABLE"
timeout "$TIMEOUT" wine "$EXECUTABLE" 2>/dev/null
exit $?
