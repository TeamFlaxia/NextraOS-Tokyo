[Unit]
Description=Setup binderfs for Waydroid
After=local-fs.target
Before=waydroid-container.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'modprobe binder_linux && mkdir -p /dev/binderfs && mount -t binder binder /dev/binderfs'
ExecStop=/bin/bash -c 'umount /dev/binderfs || true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
