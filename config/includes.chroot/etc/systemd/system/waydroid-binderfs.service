[Unit]
Description=Setup binderfs for Waydroid
After=local-fs.target
Before=waydroid-container.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c ' \
    mkdir -p /dev/binderfs && \
    if mountpoint -q /dev/binderfs 2>/dev/null; then \
        echo "binderfs already mounted"; \
    elif mount -t binder binder /dev/binderfs 2>/dev/null; then \
        echo "binderfs mounted (kernel built-in)"; \
    elif modprobe binder_linux devices="binder,hwbinder,vndbinder" 2>/dev/null && \
         mount -t binder binder /dev/binderfs 2>/dev/null; then \
        echo "binderfs mounted (module loaded)"; \
    else \
        echo "WARNING: Could not setup binder (SecureBoot or missing kernel support)"; \
    fi && \
    ln -sf /dev/binderfs/* /dev/ 2>/dev/null || true'
ExecStop=/bin/bash -c 'umount /dev/binderfs || true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
