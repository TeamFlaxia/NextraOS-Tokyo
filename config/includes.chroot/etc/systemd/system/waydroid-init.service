[Unit]
Description=Waydroid first-time initialization
After=network-online.target waydroid-binderfs.service
Wants=network-online.target
Requires=waydroid-binderfs.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/waydroid-init.sh
RemainAfterExit=yes

# Started as a dependency of the Waydroid container on first use.
