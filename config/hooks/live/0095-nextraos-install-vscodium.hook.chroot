#!/bin/sh
set -e

echo "==> NextraOS: Installing VSCodium"

# Add VSCodium GPG key
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://repo.vscodium.dev/vscodium.gpg \
    | gpg --dearmor \
    | dd of=/etc/apt/keyrings/vscodium.gpg 2>/dev/null
chmod a+r /etc/apt/keyrings/vscodium.gpg

# Add VSCodium repository (DEB822 format)
cat > /etc/apt/sources.list.d/vscodium.sources << 'REPO'
Types: deb
URIs: https://repo.vscodium.dev/deb
Suites: vscodium
Components: main
Architectures: amd64
Signed-By: /etc/apt/keyrings/vscodium.gpg
REPO

# Update and install
apt-get update -y
apt-get install -y codium

# Clean up
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "==> NextraOS: VSCodium installation complete"
