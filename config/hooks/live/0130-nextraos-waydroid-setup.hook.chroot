#!/bin/sh
set -e

echo "==> NextraOS: Setting up Waydroid"

# Debian's package enables waydroid-container.service for multi-user.target.
# Keep it available for explicit D-Bus/systemd activation, but disable boot
# activation. --root keeps this filesystem-only inside the live-build chroot.
systemctl --root=/ disable waydroid-container.service

# Do not initialize Waydroid or mount binderfs during idle boot. The
# Waydroid container unit depends on waydroid-init.service so setup and
# image download occur only when the user starts the Android runtime.

# Create waydroid data directory
mkdir -p /var/lib/waydroid

# Create /etc/waydroid directory if it doesn't exist
mkdir -p /etc/waydroid

# Configure waydroid to use system images
cat > /etc/waydroid/waydroid.cfg << 'EOF'
[waydroid]
vendor_path = /usr/share/waydroid/images
system_path = /usr/share/waydroid/images

[lxc]
lxc_path = /var/lib/waydroid/lxc
EOF

echo "==> NextraOS: Waydroid setup complete"
