#!/bin/sh
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
DIST_DIR="$PROJECT_DIR/dist"
ISO_NAME="nextraos-live-amd64.iso"

if [ "$#" -gt 0 ]; then
    ISO_FILE=$1
    shift
else
    ISO_FILE="$DIST_DIR/$ISO_NAME"
fi

if [ ! -f "$ISO_FILE" ]; then
    echo "ERROR: ISO not found: $ISO_FILE"
    echo "Build it first with: ./build/build-iso"
    exit 1
fi

. "$SCRIPT_DIR/qemu-common.sh"

echo "==> NextraOS QEMU (BIOS)"
echo "    ISO: $ISO_FILE"
echo ""

nextraos_qemu \
    -name "NextraOS" \
    -m 4G \
    -smp 2 \
    -boot d \
    -drive file="$ISO_FILE",format=raw,media=cdrom \
    -device qemu-xhci \
    -device usb-tablet \
    -device usb-kbd \
    -audiodev sdl,id=audio0 \
    -device intel-hda \
    -device hda-duplex,audiodev=audio0 \
    -netdev user,id=net0,hostfwd=tcp::2222-:22 \
    -device virtio-net-pci,netdev=net0 \
    "$@"
