#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
DIST_DIR="$PROJECT_DIR/dist"
ISO_NAME="nextraos-live-amd64.iso"

cd "$PROJECT_DIR"

mkdir -p "$DIST_DIR"

echo "==> NextraOS ISO Build"
echo "    Project: $PROJECT_DIR"
echo "    Output:  $DIST_DIR/$ISO_NAME"
echo ""

echo "==> Running lb config..."
./auto/config

echo "==> Running lb build..."
sudo lb build 2>&1 | tee "$PROJECT_DIR/build.log"

echo "==> Copying ISO to dist/"
ISO_FILES=("$PROJECT_DIR"/live-image-*.iso)
if ((${#ISO_FILES[@]} == 1)); then
    cp "${ISO_FILES[0]}" "$DIST_DIR/$ISO_NAME"
    echo "    Built: $DIST_DIR/$ISO_NAME"
    ls -lh "$DIST_DIR/$ISO_NAME"
elif ((${#ISO_FILES[@]} == 0)); then
    echo "ERROR: No ISO file produced. Check build.log for errors." >&2
    exit 1
else
    echo "ERROR: Expected one ISO, found ${#ISO_FILES[@]}. Clean the build output and retry." >&2
    exit 1
fi

echo ""
echo "==> Build complete."
